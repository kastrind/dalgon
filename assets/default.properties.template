# SIGNAL_MODE: macd (original MACD/OBV dip signal) or capitulation (buy coins that fell CAPITULATION_DROP_PERCENT within CAPITULATION_WINDOW_HOURS).
# For capitulation, backtested settings were STOP_LOSS_PERCENT=15, TAKE_PROFIT_PERCENT=12, MAX_HOLD_HOURS=24, MIN_NET_REWARD_RISK=0.7,
# BTC_MAX_DROP_PERCENT=100 and ATR_STOP_MULTIPLE=0. MAX_RISK_AMOUNT then sizes positions at about MAX_RISK_AMOUNT / 0.157.
SIGNAL_MODE=macd
CAPITULATION_DROP_PERCENT=20
CAPITULATION_WINDOW_HOURS=24

