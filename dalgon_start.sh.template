#!/bin/bash

NGROK_AUTH_TOKEN_HERE=
PRIVATE_KRAKEN_API_KEY_HERE=
VIBERBOT_AUTH_TOKEN_HERE=

exposeUrl=$(curl -s http://localhost:4040/api/tunnels | grep -Eoh 'public_url\"\s?:\s?\"https://\S+ngrok.io\"' | sed -e 's/public_url\"://g' -e 's/"//g')

if [[ -z "$exposeUrl" ]]; then
  rm ngrok.log
  nohup ngrok http 3000 --authtoken $NGROK_AUTH_TOKEN_HERE --log=stdout > ngrok.log &
  sleep 5
  exposeUrl=$(cat ngrok.log | grep -Eoh "https://.*?")
fi

#echo $exposeUrl

sed -iE "s%EXPOSE_URL=.*$%EXPOSE_URL=$exposeUrl%g" env/default.properties
nohup node dist/app.js -p $PRIVATE_KRAKEN_API_KEY_HERE -b $VIBERBOT_AUTH_TOKEN_HERE >> dalgon.log 2>&1 &
